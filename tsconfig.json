{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["root/**/*.ts", "sandbox/**/*.ts"],
  "exclude": ["**/node_modules"]
}
